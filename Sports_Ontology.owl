<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/sports.owl"
         xmlns="http://example.org/sports.owl#">

<owl:Ontology rdf:about="http://example.org/sports.owl"/>

<owl:ObjectProperty rdf:about="#PlayedAt">
  <rdfs:domain rdf:resource="#Sport"/>
  <rdfs:range rdf:resource="#Place"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#PlayedWith">
  <rdfs:domain rdf:resource="#Sport"/>
  <rdfs:range rdf:resource="#Equipment"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#PhysicalActivityLevel">
  <rdfs:domain rdf:resource="#Sport"/>
  <rdfs:range rdf:resource="#PhysicalActivity"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#PlaysSport">
  <rdfs:range rdf:resource="#Sport"/>
  <rdfs:domain rdf:resource="#SportParticipant"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#HasTeamMember">
  <rdfs:range rdf:resource="#Athlete"/>
  <rdfs:domain rdf:resource="#Team"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#IsPartOfTeam">
  <rdfs:domain rdf:resource="#Athlete"/>
  <rdfs:range rdf:resource="#Team"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#HasTeammate">
  <rdfs:domain rdf:resource="#Athlete"/>
  <rdfs:range rdf:resource="#Athlete"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#IsTeamSport">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:domain rdf:resource="#Sport"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#HasTeamSize">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#Sport"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#HasPhysicalContact">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:domain rdf:resource="#Sport"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#FirstName">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Person"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#LastName">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Person"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#DateOfBirth">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Person"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PlaceOfBirth">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Person"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#TeamName">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Team"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#Country">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Team"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Sport">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Place">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Equipment">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PhysicalActivity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Person">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#DateOfBirth"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#LastName"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#FirstName"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#PlaceOfBirth"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SportParticipant">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#Sport"/>
      <owl:onProperty rdf:resource="#PlaysSport"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#OutdoorPlace">
  <rdfs:subClassOf rdf:resource="#Place"/>
</owl:Class>

<owl:Class rdf:about="#IndoorPlace">
  <rdfs:subClassOf rdf:resource="#Place"/>
</owl:Class>

<owl:Class rdf:about="#Stadium">
  <rdfs:subClassOf rdf:resource="#OutdoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#Track">
  <rdfs:subClassOf rdf:resource="#OutdoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#Beach">
  <rdfs:subClassOf rdf:resource="#OutdoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#Pitch">
  <rdfs:subClassOf rdf:resource="#OutdoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#GolfCourse">
  <rdfs:subClassOf rdf:resource="#OutdoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#Arena">
  <rdfs:subClassOf rdf:resource="#IndoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#SwimmingPool">
  <rdfs:subClassOf rdf:resource="#IndoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#IceRink">
  <rdfs:subClassOf rdf:resource="#IndoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#IndoorCourt">
  <rdfs:subClassOf rdf:resource="#IndoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#SportsHall">
  <rdfs:subClassOf rdf:resource="#IndoorPlace"/>
</owl:Class>

<owl:Class rdf:about="#Ball">
  <rdfs:subClassOf rdf:resource="#Equipment"/>
</owl:Class>

<owl:Class rdf:about="#Racquet">
  <rdfs:subClassOf rdf:resource="#Equipment"/>
</owl:Class>

<owl:Class rdf:about="#Net">
  <rdfs:subClassOf rdf:resource="#Equipment"/>
</owl:Class>

<owl:Class rdf:about="#Board">
  <rdfs:subClassOf rdf:resource="#Equipment"/>
</owl:Class>

<owl:Class rdf:about="#MotorVehicle">
  <rdfs:subClassOf rdf:resource="#Equipment"/>
</owl:Class>

<owl:Class rdf:about="#Club">
  <rdfs:subClassOf rdf:resource="#Equipment"/>
</owl:Class>

<owl:Class rdf:about="#LowPhysicalActivity">
  <rdfs:subClassOf rdf:resource="#PhysicalActivity"/>
</owl:Class>

<owl:Class rdf:about="#MediumPhysicalActivity">
  <rdfs:subClassOf rdf:resource="#PhysicalActivity"/>
</owl:Class>

<owl:Class rdf:about="#HighPhysicalActivity">
  <rdfs:subClassOf rdf:resource="#PhysicalActivity"/>
</owl:Class>

<owl:Class rdf:about="#Athlete">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <rdfs:subClassOf rdf:resource="#SportParticipant"/>
</owl:Class>

<owl:Class rdf:about="#Team">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onClass rdf:resource="#Sport"/>
      <owl:onProperty rdf:resource="#PlaysSport"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#TeamName"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onClass rdf:resource="#Athlete"/>
      <owl:onProperty rdf:resource="#HasTeamMember"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#Country"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#SportParticipant"/>
</owl:Class>

<owl:Class rdf:about="#TeamAthlete">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#Team"/>
      <owl:onProperty rdf:resource="#IsPartOfTeam"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Athlete"/>
</owl:Class>

<owl:Class rdf:about="#IndividualSport">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#IsTeamSport"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#HasTeamSize"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Sport"/>
</owl:Class>

<owl:Class rdf:about="#TeamSport">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#IsTeamSport"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#HasTeamSize"/>
      <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minCardinality>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Sport"/>
</owl:Class>

