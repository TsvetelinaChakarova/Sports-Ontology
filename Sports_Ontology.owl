  <rdf:type rdf:resource="#StadiumSport"/>
  <rdf:type rdf:resource="#BallSport"/>
  <rdf:type rdf:resource="#NetSport"/>
  <rdf:type rdf:resource="#ContactSport"/>
  <rdf:type rdf:resource="#HighPhysicalActivitySport"/>
  <PlayedAt rdf:resource="#FootballStadium"/>
  <PlayedWith rdf:resource="#FootballBall"/>
  <PlayedWith rdf:resource="#FootballNet"/>
  <PhysicalActivityLevel rdf:resource="#Running"/>
  <HasTeamSize rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</HasTeamSize>
  <IsTeamSport rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsTeamSport>
  <HasPhysicalContact rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</HasPhysicalContact>
</owl:NamedIndividual>

