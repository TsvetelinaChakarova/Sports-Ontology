</owl:Class>

<owl:Class rdf:about="#ContactSport">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#HasPhysicalContact"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
    </owl:Restriction>
  </owl:equivalentClass>
